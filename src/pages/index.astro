---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  HOY_EXTREMADURA,
  RESUMEN_HISTORICO,
  TOP_MUNICIPIOS_BARATOS_G95,
  TOP_MUNICIPIOS_BARATOS_GASA,
  FAQS_SEO,
  fmtPrecio
} from "../data/precios";

const {
  fechaLegible,
  fechaMiteco,
  totalMunicipiosConEstacion,
  extremadura,
  provincias,
  comparativaHoy,
  principalesLocalidades,
  todasLasPoblaciones
} = HOY_EXTREMADURA;

const { badajoz, caceres } = provincias;

const badajozCiudad = todasLasPoblaciones.find((p) => p.municipio === "Badajoz")!;
const caceresCiudad = todasLasPoblaciones.find((p) => p.municipio === "Cáceres")!;

const badajozCiudadPublicas = badajozCiudad.estaciones.filter((e) => e.tipoVenta === "P");
const badajozCiudadTopGasoleo = [...badajozCiudadPublicas]
  .filter((e) => e.gasoleoA !== null)
  .sort((a, b) => (a.gasoleoA ?? 99) - (b.gasoleoA ?? 99))
  .slice(0, 5);
const badajozCiudadTopGasolina = [...badajozCiudadPublicas]
  .filter((e) => e.gasolina95 !== null)
  .sort((a, b) => (a.gasolina95 ?? 99) - (b.gasolina95 ?? 99))
  .slice(0, 5);

const caceresCiudadPublicas = caceresCiudad.estaciones.filter((e) => e.tipoVenta === "P");
const caceresCiudadTopGasoleo = [...caceresCiudadPublicas]
  .filter((e) => e.gasoleoA !== null)
  .sort((a, b) => (a.gasoleoA ?? 99) - (b.gasoleoA ?? 99))
  .slice(0, 5);
const caceresCiudadTopGasolina = [...caceresCiudadPublicas]
  .filter((e) => e.gasolina95 !== null)
  .sort((a, b) => (a.gasolina95 ?? 99) - (b.gasolina95 ?? 99))
  .slice(0, 5);

const LETRAS_MUNICIPIOS = [
  "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "L", "M", "N", "O", "P", "Q", "R", "S", "T", "U", "V", "Z"
];
---

<BaseLayout>
  <!-- ============================================================
       1. SECCIÓN PRINCIPAL: EL PRECIO DIARIO HOY + PRINCIPALES LOCALIDADES
       ============================================================ -->
  <section id="precios-hoy" class="scroll-mt-16 sm:scroll-mt-20 bg-slate-900 text-white pt-10 pb-16 lg:pt-14 lg:pb-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Cabecera Principal (H1 directo, metadatos debajo) -->
      <div class="max-w-4xl mb-10">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Precio del Combustible en Extremadura Hoy
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed mb-5">
          Cotización diaria de <strong class="text-sky-300 font-bold">Gasolina 95 E5</strong> y <strong class="text-amber-300 font-bold">Gasóleo A (Diésel)</strong> en las {extremadura.totalEstaciones} estaciones de servicio de Badajoz y Cáceres. Datos oficiales actualizados cada mañana a las 06:00h para que antes de salir a las 07:00h conozcas dónde repostar más barato.
        </p>
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/90 border border-emerald-600/60 text-emerald-200">
            <span class="pulse-dot"></span>
            <span>Datos de hoy: {fechaLegible}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-slate-200 num-tabular">
            <span>Registro MITECO: {fechaMiteco}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-sky-200 num-tabular">
            <span>{extremadura.totalEstaciones} gasolineras en {totalMunicipiosConEstacion} municipios</span>
          </span>
        </div>
      </div>

      <!-- Banners de Cotización Media Hoy en Extremadura (Gasolina 95 E5 y Gasóleo A) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">

        <!-- Banner Gasolina 95 E5 -->
        <div class="rounded-xl bg-slate-950/85 border border-sky-500/40 p-4 sm:px-5 sm:py-3.5 flex flex-col justify-between gap-2.5 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-400 shrink-0"></span>
              <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Gasolina 95 E5</h2>
              <span class="text-[11px] font-semibold text-slate-400 bg-slate-900 border border-slate-800 px-2 py-0.5 rounded-full num-tabular">
                {extremadura.estacionesGasolina95} EESS
              </span>
            </div>
            <div class="flex items-baseline gap-1.5 shrink-0">
              <span class="text-xs text-sky-300 font-semibold hidden sm:inline">Media hoy:</span>
              <span class="text-2xl sm:text-3xl font-black text-white num-tabular">
                {fmtPrecio(extremadura.mediaGasolina95)}
              </span>
              <span class="text-xs font-bold text-sky-300">€/L</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pt-2 border-t border-slate-800/80 text-xs text-slate-300">
            <div class="truncate">
              <span class="text-emerald-400 font-semibold">Mín. regional:</span>
              <strong class="text-white num-tabular font-bold ml-1">{fmtPrecio(extremadura.minGasolina95?.precio)} €/L</strong>
              <span class="text-slate-400 text-[11px] ml-1 truncate">({extremadura.minGasolina95?.rotulo} · {extremadura.minGasolina95?.municipio})</span>
            </div>
            <div class="shrink-0 text-slate-400 text-[11px] num-tabular">
              Depósito 50L: <strong class="text-slate-200 font-semibold">{fmtPrecio(extremadura.costeDeposito50L.gasolina95Media, 2)} €</strong>
            </div>
          </div>
        </div>

        <!-- Banner Gasóleo A (Diésel) -->
        <div class="rounded-xl bg-slate-950/85 border border-amber-500/40 p-4 sm:px-5 sm:py-3.5 flex flex-col justify-between gap-2.5 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0"></span>
              <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Gasóleo A (Diésel)</h2>
              <span class="text-[11px] font-semibold text-slate-400 bg-slate-900 border border-slate-800 px-2 py-0.5 rounded-full num-tabular">
                {extremadura.estacionesGasoleoA} EESS
              </span>
            </div>
            <div class="flex items-baseline gap-1.5 shrink-0">
              <span class="text-xs text-amber-300 font-semibold hidden sm:inline">Media hoy:</span>
              <span class="text-2xl sm:text-3xl font-black text-white num-tabular">
                {fmtPrecio(extremadura.mediaGasoleoA)}
              </span>
              <span class="text-xs font-bold text-amber-300">€/L</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pt-2 border-t border-slate-800/80 text-xs text-slate-300">
            <div class="truncate">
              <span class="text-emerald-400 font-semibold">Mín. regional:</span>
              <strong class="text-white num-tabular font-bold ml-1">{fmtPrecio(extremadura.minGasoleoA?.precio)} €/L</strong>
              <span class="text-slate-400 text-[11px] ml-1 truncate">({extremadura.minGasoleoA?.rotulo} · {extremadura.minGasoleoA?.municipio})</span>
            </div>
            <div class="shrink-0 text-slate-400 text-[11px] num-tabular">
              Depósito 50L: <strong class="text-slate-200 font-semibold">{fmtPrecio(extremadura.costeDeposito50L.gasoleoAMedia, 2)} €</strong>
            </div>
          </div>
        </div>

      </div>

      <!-- DOS CAJAS CAPITALES DE PROVINCIA: BADAJOZ CAPITAL Y CÁCERES CAPITAL (PRECIOS GASOLINA Y DIÉSEL + FORMATO TOP 5) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-14">

        <!-- Caja 1: Badajoz Capital · Precios Gasolina y Diésel + Top 5 Más Baratas Hoy -->
        <div data-top-group="badajoz-capital" class="rounded-2xl bg-slate-950/90 border border-sky-500/35 p-6 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-800 mb-4">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-sky-400"></span>
                <h2 class="text-base font-bold text-white tracking-normal">
                  Badajoz Capital · Top 5 Hoy
                </h2>
                <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-sky-950 text-sky-200 border border-sky-700/60 num-tabular">
                  {badajozCiudad.numEstaciones} EESS
                </span>
              </div>

              <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-700" role="tablist" aria-label="Combustible Top 5 Badajoz Capital">
                <button
                  type="button"
                  role="tab"
                  data-group-tab="badajoz-cap-gasoleo"
                  aria-selected="true"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-amber-600 aria-selected:text-white transition-colors cursor-pointer"
                >
                  Diésel
                </button>
                <button
                  type="button"
                  role="tab"
                  data-group-tab="badajoz-cap-gasolina"
                  aria-selected="false"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-sky-600 aria-selected:text-white transition-colors cursor-pointer"
                >
                  Gasolina 95
                </button>
              </div>
            </div>

            <!-- Resumen de precios medios y mínimos hoy en Badajoz Capital -->
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="rounded-xl bg-slate-900/90 border border-sky-500/30 px-3.5 py-2.5 flex items-center justify-between gap-2">
                <div>
                  <span class="block text-[11px] font-semibold text-sky-300">Gasolina 95 · Badajoz</span>
                  <span class="text-lg sm:text-xl font-black text-white num-tabular">
                    {fmtPrecio(badajozCiudad.mediaGasolina95)} <span class="text-xs font-bold text-sky-300">€/L</span>
                  </span>
                </div>
                <div class="text-right">
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Mín. hoy</span>
                  <span class="text-xs font-extrabold text-emerald-300 num-tabular">
                    {fmtPrecio(badajozCiudad.minGasolina95)} €
                  </span>
                </div>
              </div>

              <div class="rounded-xl bg-slate-900/90 border border-amber-500/30 px-3.5 py-2.5 flex items-center justify-between gap-2">
                <div>
                  <span class="block text-[11px] font-semibold text-amber-300">Gasóleo A · Badajoz</span>
                  <span class="text-lg sm:text-xl font-black text-white num-tabular">
                    {fmtPrecio(badajozCiudad.mediaGasoleoA)} <span class="text-xs font-bold text-amber-300">€/L</span>
                  </span>
                </div>
                <div class="text-right">
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Mín. hoy</span>
                  <span class="text-xs font-extrabold text-emerald-300 num-tabular">
                    {fmtPrecio(badajozCiudad.minGasoleoA)} €
                  </span>
                </div>
              </div>
            </div>

            <!-- Lista Top 5 Diésel en Badajoz Capital -->
            <div data-group-panel="badajoz-cap-gasoleo" class="divide-y divide-slate-800/90 text-xs">
              {badajozCiudadTopGasoleo.map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est.rotulo} · <span class="text-amber-300">CP {est.cp}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est.gasoleoA)} €
                  </span>
                </div>
              ))}
            </div>

            <!-- Lista Top 5 Gasolina 95 en Badajoz Capital -->
            <div data-group-panel="badajoz-cap-gasolina" class="hidden divide-y divide-slate-800/90 text-xs">
              {badajozCiudadTopGasolina.map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est.rotulo} · <span class="text-sky-300">CP {est.cp}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est.gasolina95)} €
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-3 mt-2 border-t border-slate-800 flex items-center justify-between gap-2 text-xs text-slate-300">
            <span class="num-tabular">
              50L media: <strong class="text-sky-300">{fmtPrecio((badajozCiudad.mediaGasolina95 ?? 0) * 50, 2)} €</strong> (G95) · <strong class="text-amber-300">{fmtPrecio((badajozCiudad.mediaGasoleoA ?? 0) * 50, 2)} €</strong> (Diésel)
            </span>
            <button
              type="button"
              data-jump-municipio="Badajoz"
              class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-700 text-xs font-semibold text-white border border-slate-700 transition-colors cursor-pointer shrink-0"
            >
              Ver las {badajozCiudad.numEstaciones} EESS
            </button>
          </div>
        </div>

        <!-- Caja 2: Cáceres Capital · Precios Gasolina y Diésel + Top 5 Más Baratas Hoy -->
        <div data-top-group="caceres-capital" class="rounded-2xl bg-slate-950/90 border border-amber-500/35 p-6 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-800 mb-4">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                <h2 class="text-base font-bold text-white tracking-normal">
                  Cáceres Capital · Top 5 Hoy
                </h2>
                <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-950 text-amber-200 border border-amber-700/60 num-tabular">
                  {caceresCiudad.numEstaciones} EESS
                </span>
              </div>

              <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-700" role="tablist" aria-label="Combustible Top 5 Cáceres Capital">
                <button
                  type="button"
                  role="tab"
                  data-group-tab="caceres-cap-gasoleo"
                  aria-selected="true"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-amber-600 aria-selected:text-white transition-colors cursor-pointer"
                >
                  Diésel
                </button>
                <button
                  type="button"
                  role="tab"
                  data-group-tab="caceres-cap-gasolina"
                  aria-selected="false"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-sky-600 aria-selected:text-white transition-colors cursor-pointer"
                >
                  Gasolina 95
                </button>
              </div>
            </div>

            <!-- Resumen de precios medios y mínimos hoy en Cáceres Capital -->
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="rounded-xl bg-slate-900/90 border border-sky-500/30 px-3.5 py-2.5 flex items-center justify-between gap-2">
                <div>
                  <span class="block text-[11px] font-semibold text-sky-300">Gasolina 95 · Cáceres</span>
                  <span class="text-lg sm:text-xl font-black text-white num-tabular">
                    {fmtPrecio(caceresCiudad.mediaGasolina95)} <span class="text-xs font-bold text-sky-300">€/L</span>
                  </span>
                </div>
                <div class="text-right">
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Mín. hoy</span>
                  <span class="text-xs font-extrabold text-emerald-300 num-tabular">
                    {fmtPrecio(caceresCiudad.minGasolina95)} €
                  </span>
                </div>
              </div>

              <div class="rounded-xl bg-slate-900/90 border border-amber-500/30 px-3.5 py-2.5 flex items-center justify-between gap-2">
                <div>
                  <span class="block text-[11px] font-semibold text-amber-300">Gasóleo A · Cáceres</span>
                  <span class="text-lg sm:text-xl font-black text-white num-tabular">
                    {fmtPrecio(caceresCiudad.mediaGasoleoA)} <span class="text-xs font-bold text-amber-300">€/L</span>
                  </span>
                </div>
                <div class="text-right">
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Mín. hoy</span>
                  <span class="text-xs font-extrabold text-emerald-300 num-tabular">
                    {fmtPrecio(caceresCiudad.minGasoleoA)} €
                  </span>
                </div>
              </div>
            </div>

            <!-- Lista Top 5 Diésel en Cáceres Capital -->
            <div data-group-panel="caceres-cap-gasoleo" class="divide-y divide-slate-800/90 text-xs">
              {caceresCiudadTopGasoleo.map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est.rotulo} · <span class="text-amber-300">CP {est.cp}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est.gasoleoA)} €
                  </span>
                </div>
              ))}
            </div>

            <!-- Lista Top 5 Gasolina 95 en Cáceres Capital -->
            <div data-group-panel="caceres-cap-gasolina" class="hidden divide-y divide-slate-800/90 text-xs">
              {caceresCiudadTopGasolina.map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est.rotulo} · <span class="text-sky-300">CP {est.cp}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est.gasolina95)} €
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-3 mt-2 border-t border-slate-800 flex items-center justify-between gap-2 text-xs text-slate-300">
            <span class="num-tabular">
              50L media: <strong class="text-sky-300">{fmtPrecio((caceresCiudad.mediaGasolina95 ?? 0) * 50, 2)} €</strong> (G95) · <strong class="text-amber-300">{fmtPrecio((caceresCiudad.mediaGasoleoA ?? 0) * 50, 2)} €</strong> (Diésel)
            </span>
            <button
              type="button"
              data-jump-municipio="Cáceres"
              class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-700 text-xs font-semibold text-white border border-slate-700 transition-colors cursor-pointer shrink-0"
            >
              Ver las {caceresCiudad.numEstaciones} EESS
            </button>
          </div>
        </div>

      </div>

      <!-- SUB-BLOQUE EN HERO: PRINCIPALES LOCALIDADES DE EXTREMADURA HOY -->
      <div class="rounded-2xl bg-slate-950/90 border border-slate-800 overflow-hidden">
        <div class="p-6 sm:p-7 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-1">
              Precio Hoy en las Principales Localidades de Extremadura
            </h2>
            <p class="text-xs sm:text-sm text-slate-300">
              Medias del día y surtidor más económico hoy en las 16 principales ciudades y cabeceras comarcales. Pulsa sobre cualquier localidad para ver todas sus estaciones.
            </p>
          </div>
          <a
            href="#todas-las-poblaciones"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-colors self-start sm:self-auto shrink-0"
          >
            <span>Buscar en los {totalMunicipiosConEstacion} municipios</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/90 text-xs font-bold uppercase text-slate-300 border-b border-slate-800">
              <tr>
                <th class="px-5 py-3.5">Localidad</th>
                <th class="px-3 py-3.5 text-center">EESS</th>
                <th class="px-4 py-3.5 text-right">Media Gasolina 95</th>
                <th class="px-4 py-3.5 text-right">Mín. Gasolina 95</th>
                <th class="px-4 py-3.5 text-right">Media Gasóleo A</th>
                <th class="px-4 py-3.5 text-right">Mín. Gasóleo A</th>
                <th class="px-5 py-3.5">Estación más económica hoy (Diésel)</th>
                <th class="px-4 py-3.5 text-right">Detalle</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-200">
              {principalesLocalidades.map((loc) => (
                <tr class="hover:bg-slate-900/70 transition-colors">
                  <td class="px-5 py-3.5 font-bold text-white">
                    <div class="flex items-center gap-2">
                      <span
                        class={`w-2 h-2 rounded-full ${
                          loc.codigoProvincia === "06" ? "bg-sky-400" : "bg-amber-400"
                        }`}
                      ></span>
                      <span>{loc.municipio}</span>
                      <span class="text-xs font-normal text-slate-300">({loc.provincia})</span>
                    </div>
                  </td>
                  <td class="px-3 py-3.5 text-center font-semibold text-slate-300 num-tabular">
                    {loc.numEstaciones}
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-sky-300 num-tabular">
                    {fmtPrecio(loc.mediaGasolina95)} €/L
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-emerald-300 num-tabular">
                    {fmtPrecio(loc.minGasolina95)} €/L
                  </td>

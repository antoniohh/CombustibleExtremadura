---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  HOY_EXTREMADURA,
  MESES_HISTORICO,
  RESUMEN_HISTORICO,
  TOP_MUNICIPIOS_BARATOS_G95,
  TOP_MUNICIPIOS_BARATOS_GASA,
  API_MITECO,
  FAQS_SEO,
  fmtPrecio
} from "../data/precios";

const {
  fechaLegible,
  fechaMiteco,
  totalMunicipiosConEstacion,
  extremadura,
  provincias,
  comparativaHoy,
  principalesLocalidades,
  todasLasPoblaciones
} = HOY_EXTREMADURA;

const { badajoz, caceres } = provincias;

const LETRAS_MUNICIPIOS = [
  "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "L", "M", "N", "O", "P", "Q", "R", "S", "T", "U", "V", "Z"
];

const curlCode = `# 1. Capturar todas las estaciones activas hoy en Extremadura (CCAA 11)
curl -s "https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestres/FiltroCCAA/11" \\
  -H "Accept: application/json" -o hoy_extremadura_raw.json

# 2. Consultar histórico de un día concreto en Extremadura (Ej: Gasóleo A = ID 3)
curl -s "https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestresHist/FiltroCCAAProducto/30-09-2026/11/3" \\
  -H "Accept: application/json" -o historico_dia.json`;

const scriptsRepoCode = `# Actualizar precios de HOY (se ejecuta automáticamente a las 06:00 AM en GitHub Actions)
npm run actualizar:hoy

# Actualizar incrementalmente los JSON históricos al cierre de cada mes (ejecución manual)
npm run historico:mes
# O indicando un rango de fechas específico:
node scripts/actualizar_historico_mes.mjs 2026-10-01 2026-10-31`;
---

<BaseLayout>
  <!-- ============================================================
       1. SECCIÓN PRINCIPAL: EL PRECIO DIARIO HOY + PRINCIPALES LOCALIDADES
       ============================================================ -->
  <section id="precios-hoy" class="scroll-mt-16 sm:scroll-mt-20 bg-slate-900 text-white pt-10 pb-16 lg:pt-14 lg:pb-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Cabecera Principal (H1 directo, metadatos debajo) -->
      <div class="max-w-4xl mb-10">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Precio del Combustible en Extremadura Hoy
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed mb-5">
          Cotización diaria de <strong class="text-sky-300 font-bold">Gasolina 95 E5</strong> y <strong class="text-amber-300 font-bold">Gasóleo A (Diésel)</strong> en las {extremadura.totalEstaciones} estaciones de servicio de Badajoz y Cáceres. Datos oficiales actualizados cada mañana a las 06:00h para que antes de salir a las 07:00h conozcas dónde repostar más barato.
        </p>
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/90 border border-emerald-600/60 text-emerald-200">
            <span class="pulse-dot"></span>
            <span>Datos de hoy: {fechaLegible}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-slate-200 num-tabular">
            <span>Registro MITECO: {fechaMiteco}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-sky-200 num-tabular">
            <span>{extremadura.totalEstaciones} gasolineras en {totalMunicipiosConEstacion} municipios</span>
          </span>
        </div>
      </div>

      <!-- Paneles Principales de Precio de Hoy en Extremadura -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-14">

        <!-- Panel Gasolina 95 E5 Hoy -->
        <div class="lg:col-span-4 rounded-2xl bg-slate-950/90 border border-sky-500/40 p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 pb-4 border-b border-slate-800">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-sky-400"></span>
                <h2 class="text-base font-bold text-white tracking-normal">Gasolina 95 E5 · Hoy</h2>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-950 text-sky-200 border border-sky-700/60 num-tabular">
                {extremadura.estacionesGasolina95} EESS
              </span>
            </div>

            <div class="my-5 flex items-baseline justify-between gap-4">
              <div>
                <span class="block text-xs font-semibold text-sky-200 mb-1">Media Extremadura hoy</span>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-black text-white num-tabular">
                    {fmtPrecio(extremadura.mediaGasolina95)}
                  </span>
                  <span class="text-base font-bold text-sky-300">€/L</span>
                </div>
              </div>
              <div class="text-right">
                <span class="block text-xs font-semibold text-slate-300 mb-1">Depósito 50L (media)</span>
                <span class="text-xl font-extrabold text-sky-200 num-tabular">
                  {fmtPrecio(extremadura.costeDeposito50L.gasolina95Media, 2)} €
                </span>
              </div>
            </div>
          </div>

          <!-- Mínimo y Máximo del día en Extremadura -->
          <div class="space-y-2.5 pt-4 border-t border-slate-800 text-xs">
            <div class="flex items-start justify-between gap-3 bg-emerald-950/50 border border-emerald-700/50 rounded-xl p-3">
              <div>
                <span class="block font-bold text-emerald-300">Mínimo hoy en Extremadura</span>
                <span class="block text-slate-200 font-semibold mt-0.5">
                  {extremadura.minGasolina95?.rotulo} · {extremadura.minGasolina95?.municipio}
                </span>
                <span class="block text-slate-300 text-[11px]">{extremadura.minGasolina95?.direccion}</span>
              </div>
              <div class="text-right shrink-0">
                <span class="block text-lg font-black text-emerald-300 num-tabular">
                  {fmtPrecio(extremadura.minGasolina95?.precio)} €/L
                </span>
                <span class="block text-[11px] text-emerald-200 num-tabular">
                  50L: {fmtPrecio(extremadura.costeDeposito50L.gasolina95Min, 2)} €
                </span>
              </div>
            </div>

            <div class="flex items-center justify-between px-2 pt-1 text-slate-300">
              <span>Máximo hoy ({extremadura.maxGasolina95?.municipio}): <strong class="text-white num-tabular">{fmtPrecio(extremadura.maxGasolina95?.precio)} €/L</strong></span>
              <span class="text-emerald-300 font-bold num-tabular">
                Ahorro máx: {fmtPrecio(extremadura.costeDeposito50L.ahorroMaxGasolina95_50L, 2)} €/dep.
              </span>
            </div>
          </div>
        </div>

        <!-- Panel Gasóleo A (Diésel) Hoy -->
        <div class="lg:col-span-4 rounded-2xl bg-slate-950/90 border border-amber-500/40 p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 pb-4 border-b border-slate-800">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
                <h2 class="text-base font-bold text-white tracking-normal">Gasóleo A (Diésel) · Hoy</h2>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-950 text-amber-200 border border-amber-700/60 num-tabular">
                {extremadura.estacionesGasoleoA} EESS
              </span>
            </div>

            <div class="my-5 flex items-baseline justify-between gap-4">
              <div>
                <span class="block text-xs font-semibold text-amber-200 mb-1">Media Extremadura hoy</span>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-4xl sm:text-5xl font-black text-white num-tabular">
                    {fmtPrecio(extremadura.mediaGasoleoA)}
                  </span>
                  <span class="text-base font-bold text-amber-300">€/L</span>
                </div>
              </div>
              <div class="text-right">
                <span class="block text-xs font-semibold text-slate-300 mb-1">Depósito 50L (media)</span>
                <span class="text-xl font-extrabold text-amber-200 num-tabular">
                  {fmtPrecio(extremadura.costeDeposito50L.gasoleoAMedia, 2)} €
                </span>
              </div>
            </div>
          </div>

          <!-- Mínimo y Máximo del día en Extremadura -->
          <div class="space-y-2.5 pt-4 border-t border-slate-800 text-xs">
            <div class="flex items-start justify-between gap-3 bg-emerald-950/50 border border-emerald-700/50 rounded-xl p-3">
              <div>
                <span class="block font-bold text-emerald-300">Mínimo hoy en Extremadura</span>
                <span class="block text-slate-200 font-semibold mt-0.5">
                  {extremadura.minGasoleoA?.rotulo} · {extremadura.minGasoleoA?.municipio}
                </span>
                <span class="block text-slate-300 text-[11px]">{extremadura.minGasoleoA?.direccion}</span>
              </div>
              <div class="text-right shrink-0">
                <span class="block text-lg font-black text-emerald-300 num-tabular">
                  {fmtPrecio(extremadura.minGasoleoA?.precio)} €/L
                </span>
                <span class="block text-[11px] text-emerald-200 num-tabular">
                  50L: {fmtPrecio(extremadura.costeDeposito50L.gasoleoAMin, 2)} €
                </span>
              </div>
            </div>

            <div class="flex items-center justify-between px-2 pt-1 text-slate-300">
              <span>Máximo hoy ({extremadura.maxGasoleoA?.municipio}): <strong class="text-white num-tabular">{fmtPrecio(extremadura.maxGasoleoA?.precio)} €/L</strong></span>
              <span class="text-emerald-300 font-bold num-tabular">
                Ahorro máx: {fmtPrecio(extremadura.costeDeposito50L.ahorroMaxGasoleoA_50L, 2)} €/dep.
              </span>
            </div>
          </div>
        </div>

        <!-- Panel Top 5 Gasolineras Más Baratas Hoy en Extremadura -->
        <div class="lg:col-span-4 rounded-2xl bg-slate-950/90 border border-slate-700 p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 pb-3 border-b border-slate-800 mb-3">
              <h2 class="text-base font-bold text-white tracking-normal">Top 5 Más Baratas Hoy</h2>
              <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-700" role="tablist">
                <button
                  type="button"
                  role="tab"
                  data-top-tab="gasoleo"
                  aria-selected="true"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-amber-600 aria-selected:text-white transition-colors"
                >
                  Diésel
                </button>
                <button
                  type="button"
                  role="tab"
                  data-top-tab="gasolina"
                  aria-selected="false"
                  class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-200 aria-selected:bg-sky-600 aria-selected:text-white transition-colors"
                >
                  Gasolina 95
                </button>
              </div>
            </div>

            <!-- Lista Top 5 Diésel -->
            <div data-top-panel="gasoleo" class="divide-y divide-slate-800/90 text-xs">
              {extremadura.topBaratasGasoleoA.slice(0, 5).map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est?.rotulo} · <span class="text-amber-300">{est?.municipio}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est?.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est?.precio)} €
                  </span>
                </div>
              ))}
            </div>

            <!-- Lista Top 5 Gasolina 95 -->
            <div data-top-panel="gasolina" class="hidden divide-y divide-slate-800/90 text-xs">
              {extremadura.topBaratasGasolina95.slice(0, 5).map((est) => (
                <div class="py-2.5 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <span class="block font-bold text-white truncate">
                      {est?.rotulo} · <span class="text-sky-300">{est?.municipio}</span>
                    </span>
                    <span class="block text-slate-300 text-[11px] truncate">{est?.direccion}</span>
                  </div>
                  <span class="font-black text-sm text-emerald-300 num-tabular shrink-0">
                    {fmtPrecio(est?.precio)} €
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-3 mt-2 border-t border-slate-800 flex items-center justify-between text-xs text-slate-300">
            <span>Brecha Diésel − Gasolina hoy:</span>
            <span class="font-bold text-amber-300 num-tabular">
              +{fmtPrecio((extremadura.diferencialDieselGasolina ?? 0) * 100, 1)} cts/L
            </span>
          </div>
        </div>

      </div>

      <!-- SUB-BLOQUE EN HERO: PRINCIPALES LOCALIDADES DE EXTREMADURA HOY -->
      <div class="rounded-2xl bg-slate-950/90 border border-slate-800 overflow-hidden">
        <div class="p-6 sm:p-7 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-1">
              Precio Hoy en las Principales Localidades de Extremadura
            </h2>
            <p class="text-xs sm:text-sm text-slate-300">
              Medias del día y surtidor más económico hoy en las 16 principales ciudades y cabeceras comarcales. Pulsa sobre cualquier localidad para ver todas sus estaciones.
            </p>
          </div>
          <a
            href="#todas-las-poblaciones"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-colors self-start sm:self-auto shrink-0"
          >
            <span>Buscar en los {totalMunicipiosConEstacion} municipios</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/90 text-xs font-bold uppercase text-slate-300 border-b border-slate-800">
              <tr>
                <th class="px-5 py-3.5">Localidad</th>
                <th class="px-3 py-3.5 text-center">EESS</th>
                <th class="px-4 py-3.5 text-right">Media Gasolina 95</th>
                <th class="px-4 py-3.5 text-right">Mín. Gasolina 95</th>
                <th class="px-4 py-3.5 text-right">Media Gasóleo A</th>
                <th class="px-4 py-3.5 text-right">Mín. Gasóleo A</th>
                <th class="px-5 py-3.5">Estación más económica hoy (Diésel)</th>
                <th class="px-4 py-3.5 text-right">Detalle</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-200">
              {principalesLocalidades.map((loc) => (
                <tr class="hover:bg-slate-900/70 transition-colors">
                  <td class="px-5 py-3.5 font-bold text-white">
                    <div class="flex items-center gap-2">
                      <span
                        class={`w-2 h-2 rounded-full ${
                          loc.codigoProvincia === "06" ? "bg-sky-400" : "bg-amber-400"
                        }`}
                      ></span>
                      <span>{loc.municipio}</span>
                      <span class="text-xs font-normal text-slate-300">({loc.provincia})</span>
                    </div>
                  </td>
                  <td class="px-3 py-3.5 text-center font-semibold text-slate-300 num-tabular">
                    {loc.numEstaciones}
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-sky-300 num-tabular">
                    {fmtPrecio(loc.mediaGasolina95)} €/L
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-emerald-300 num-tabular">
                    {fmtPrecio(loc.minGasolina95)} €/L
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-amber-300 num-tabular">
                    {fmtPrecio(loc.mediaGasoleoA)} €/L
                  </td>
                  <td class="px-4 py-3.5 text-right font-bold text-emerald-300 num-tabular">
                    {fmtPrecio(loc.minGasoleoA)} €/L
                  </td>
                  <td class="px-5 py-3.5 text-xs text-slate-300">
                    {loc.mejorEstacionGasoleoA ? (
                      <div>
                        <strong class="text-white">{loc.mejorEstacionGasoleoA.rotulo}</strong>
                        <span class="block text-[11px] text-slate-300 truncate max-w-xs">
                          {loc.mejorEstacionGasoleoA.direccion}
                        </span>
                      </div>
                    ) : (
                      "—"
                    )}
                  </td>
                  <td class="px-4 py-3.5 text-right">
                    <button
                      type="button"
                      data-jump-municipio={loc.municipio}
                      class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-700 text-xs font-semibold text-white border border-slate-700 transition-colors"
                    >
                      Ver {loc.numEstaciones}
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       2. SECCIÓN: COMPARATIVA CÁCERES VS BADAJOZ EN EL DÍA ACTUAL
       ============================================================ -->
  <section id="comparativa-provincias" class="scroll-mt-16 sm:scroll-mt-20 py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="max-w-3xl mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
          Comparativa en el Día Actual: Badajoz frente a Cáceres
        </h2>
        <p class="text-slate-700 text-base leading-relaxed">
          Análisis directo de los precios registrados hoy ({fechaLegible}) entre las {badajoz.totalEstaciones} estaciones de la provincia de Badajoz y las {caceres.totalEstaciones} estaciones de la provincia de Cáceres.
        </p>
      </div>

      <!-- Resumen Ejecutivo del duelo provincial de hoy -->
      <div class="surface-panel p-6 sm:p-8 mb-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 divide-y lg:divide-y-0 lg:divide-x divide-slate-200">

          <!-- Columna 1: Provincia de Badajoz Hoy -->
          <div class=" lg:pr-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-sky-600"></span>
                <h3 class="text-xl font-extrabold text-slate-900">Provincia de Badajoz</h3>
              </div>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-900 border border-sky-200 num-tabular">
                {badajoz.totalEstaciones} EESS · {badajoz.totalMunicipios} municipios
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4 py-3 border-y border-slate-200 my-4">
              <div>
                <span class="block text-xs font-semibold text-slate-600">Gasolina 95 hoy</span>
                <span class="text-2xl sm:text-3xl font-black text-sky-800 num-tabular">
                  {fmtPrecio(badajoz.mediaGasolina95)} €
                </span>
                <span class="block text-xs text-slate-600 mt-1 num-tabular">
                  50L: <strong>{fmtPrecio(badajoz.costeDeposito50L.gasolina95Media, 2)} €</strong>
                </span>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-600">Gasóleo A hoy</span>
                <span class="text-2xl sm:text-3xl font-black text-amber-800 num-tabular">
                  {fmtPrecio(badajoz.mediaGasoleoA)} €
                </span>
                <span class="block text-xs text-slate-600 mt-1 num-tabular">
                  50L: <strong>{fmtPrecio(badajoz.costeDeposito50L.gasoleoAMedia, 2)} €</strong>
                </span>
              </div>
            </div>

            <dl class="space-y-2 text-xs text-slate-700">
              <div class="flex justify-between">
                <dt>Gasolina 95 más barata hoy:</dt>
                <dd class="font-bold text-slate-900 num-tabular">
                  {fmtPrecio(badajoz.minGasolina95?.precio)} € ({badajoz.minGasolina95?.municipio})
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Diésel más barato hoy:</dt>
                <dd class="font-bold text-slate-900 num-tabular">
                  {fmtPrecio(badajoz.minGasoleoA?.precio)} € ({badajoz.minGasoleoA?.municipio})
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Surtidores bajo media regional (Diésel):</dt>
                <dd class="font-bold text-emerald-800 num-tabular">
                  {badajoz.bajoMediaRegionalGasA} de {badajoz.estacionesGasoleoA} estaciones
                </dd>
              </div>
            </dl>
          </div>

          <!-- Columna 2: Provincia de Cáceres Hoy -->
          <div class="pt-6 lg:pt-0 lg:px-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-amber-600"></span>
                <h3 class="text-xl font-extrabold text-slate-900">Provincia de Cáceres</h3>
              </div>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200 num-tabular">
                {caceres.totalEstaciones} EESS · {caceres.totalMunicipios} municipios
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4 py-3 border-y border-slate-200 my-4">
              <div>
                <span class="block text-xs font-semibold text-slate-600">Gasolina 95 hoy</span>
                <span class="text-2xl sm:text-3xl font-black text-sky-800 num-tabular">
                  {fmtPrecio(caceres.mediaGasolina95)} €
                </span>
                <span class="block text-xs text-slate-600 mt-1 num-tabular">
                  50L: <strong>{fmtPrecio(caceres.costeDeposito50L.gasolina95Media, 2)} €</strong>
                </span>
              </div>
              <div>
                <span class="block text-xs font-semibold text-slate-600">Gasóleo A hoy</span>
                <span class="text-2xl sm:text-3xl font-black text-amber-800 num-tabular">

            <span class="block text-xs font-bold uppercase text-slate-600 mb-1">Techo Histórico Gasolina 95</span>
            <span class="text-2xl sm:text-3xl font-black text-slate-900 num-tabular">
              {fmtPrecio(RESUMEN_HISTORICO.diaMaxG95.precio)} €/L
            </span>
            <span class="block text-xs text-slate-700 mt-1">
              Registrado el <strong>{RESUMEN_HISTORICO.diaMaxG95.fecha}</strong> (+{fmtPrecio(RESUMEN_HISTORICO.oscilacionDeposito50LG95, 2)} € por depósito de 50L)
            </span>
          </div>

          <div class="pt-4 sm:pt-0 sm:px-4">
            <span class="block text-xs font-bold uppercase text-slate-600 mb-1">Suelo Histórico Gasóleo A</span>
            <span class="text-2xl sm:text-3xl font-black text-amber-800 num-tabular">
              {fmtPrecio(RESUMEN_HISTORICO.diaMinGasA.precio)} €/L
            </span>
            <span class="block text-xs text-slate-700 mt-1">
              Registrado el <strong>{RESUMEN_HISTORICO.diaMinGasA.fecha}</strong> (Media mayo 25: {fmtPrecio(RESUMEN_HISTORICO.mesMinGasA.extremadura.gasoleoA)} €)
            </span>
          </div>

          <div class="pt-4 sm:pt-0 sm:pl-4">
            <span class="block text-xs font-bold uppercase text-slate-600 mb-1">Techo Histórico Gasóleo A</span>
            <span class="text-2xl sm:text-3xl font-black text-slate-900 num-tabular">
              {fmtPrecio(RESUMEN_HISTORICO.diaMaxGasA.precio)} €/L
            </span>
            <span class="block text-xs text-slate-700 mt-1">
              Registrado el <strong>{RESUMEN_HISTORICO.diaMaxGasA.fecha}</strong> (+{fmtPrecio(RESUMEN_HISTORICO.oscilacionDeposito50LGasA, 2)} € por depósito de 50L)
            </span>
          </div>
        </div>
      </div>

      <!-- GRÁFICO 1 (PRINCIPAL): CURVA DIARIA INTERACTIVA 2025-2026 -->
      <div class="surface-panel p-6 sm:p-8 mb-8">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-6 border-b border-slate-200">
          <div>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">
              Curva Diaria de Precios en Extremadura (2025–2026)
            </h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Evolución día a día de la Gasolina 95 E5 y el Gasóleo A. Filtra por año o por provincia para explorar la serie.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <!-- Selector de Territorio -->
            <div class="inline-flex rounded-xl bg-slate-100 p-1 border border-slate-200" role="group" aria-label="Territorio">
              <button type="button" data-chart-region="extremadura" aria-selected="true" class="tab-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-800">
                Extremadura
              </button>
              <button type="button" data-chart-region="badajoz" aria-selected="false" class="tab-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-800">
                Badajoz
              </button>
              <button type="button" data-chart-region="caceres" aria-selected="false" class="tab-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-800">
                Cáceres
              </button>
            </div>

            <!-- Selector de Periodo -->
            <div class="inline-flex rounded-xl bg-slate-100 p-1 border border-slate-200" role="group" aria-label="Periodo">
              <button type="button" data-chart-range="todo" aria-selected="true" class="tab-btn px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800">
                2025–2026
              </button>
              <button type="button" data-chart-range="2025" aria-selected="false" class="tab-btn px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800">
                Año 2025
              </button>
              <button type="button" data-chart-range="2026" aria-selected="false" class="tab-btn px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800">
                Año 2026
              </button>
              <button type="button" data-chart-range="90d" aria-selected="false" class="tab-btn px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800">
                Últimos 90d
              </button>
            </div>
          </div>
        </div>

        <div class="chart-box">
          <canvas id="chart-evolucion-diaria" aria-label="Gráfico de evolución diaria de precios de carburantes en Extremadura 2025 y 2026"></canvas>
        </div>
      </div>

      <!-- GRÁFICO: HISTOGRAMA DE MEDIAS MENSUALES (2025 - 2026) -->
      <div class="surface-panel p-6 sm:p-8 mb-12">
        <div class="pb-4 mb-5 border-b border-slate-200">
          <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">
            Comparativa de Medias Mensuales Consolidadas (Enero 2025 – Actualidad)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600">
            Promedio mensual de los 21 meses registrados en Extremadura para Gasolina 95 E5 y Gasóleo A
          </p>
        </div>
        <div class="chart-box">
          <canvas id="chart-medias-mensuales" aria-label="Gráfico de barras con las medias mensuales de combustible en Extremadura"></canvas>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       5. SECCIÓN: GUÍA PRÁCTICA EXTENSA + CALCULADORA DE AHORRO
       ============================================================ -->
  <section id="guia-ahorro" class="scroll-mt-16 sm:scroll-mt-20 py-16 lg:py-24 bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="max-w-3xl mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
          Guía Práctica Completa: Cómo Ahorrar al Repostar en Extremadura
        </h2>
        <p class="text-slate-700 text-base leading-relaxed">
          Factores técnicos, logísticos y geográficos que determinan el precio del litro en las carreteras extremeñas y cómo aprovecharlos a tu favor.
        </p>
      </div>

      <!-- Calculadora Interactiva de Repostaje y Ahorro -->
      <div
        id="calculadora-repostaje"
        data-media-g95={extremadura.mediaGasolina95}
        data-min-g95={extremadura.minGasolina95?.precio}
        data-media-gasa={extremadura.mediaGasoleoA}
        data-min-gasa={extremadura.minGasoleoA?.precio}
        class="surface-panel p-6 sm:p-8 mb-12"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <h3 class="text-xl font-extrabold text-slate-900">
              Calculadora de Ahorro Real en Extremadura Con los Precios de Hoy
            </h3>
            <p class="text-xs sm:text-sm text-slate-700">
              Ajusta el tamaño de tu depósito y los kilómetros que recorres al año para calcular cuánto ahorras repostando en los surtidores más económicos de la región frente al precio medio de hoy.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 pt-2">
              <div>
                <label for="calc-combustible" class="block text-xs font-bold text-slate-800 mb-1">
                  Combustible
                </label>
                <select
                  id="calc-combustible"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-900"
                >
                  <option value="gasoleo">Gasóleo A (Diésel)</option>
                  <option value="gasolina">Gasolina 95 E5</option>
                </select>
              </div>

              <div>
                <label for="calc-litros" class="block text-xs font-bold text-slate-800 mb-1">
                  Depósito (Litros)
                </label>
                <input
                  id="calc-litros"
                  type="number"
                  min="15"
                  max="120"
                  value="55"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-900 num-tabular"
                />
              </div>

              <div>
                <label for="calc-km" class="block text-xs font-bold text-slate-800 mb-1">
                  Km al año
                </label>
                <input
                  id="calc-km"
                  type="number"
                  min="2000"
                  max="120000"
                  step="1000"
                  value="18000"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-900 num-tabular"
                />
              </div>

              <div>
                <label for="calc-consumo" class="block text-xs font-bold text-slate-800 mb-1">
                  Consumo (L/100km)
                </label>
                <input
                  id="calc-consumo"
                  type="number"
                  min="3"
                  max="20"
                  step="0.1"
                  value="6.0"
                  class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-900 num-tabular"
                />
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 bg-slate-900 text-white rounded-2xl p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4 pb-4 border-b border-slate-800">
              <div>
                <span class="block text-xs text-slate-300">Llenar a precio medio hoy</span>
                <span id="calc-out-medio" class="text-xl font-extrabold text-slate-200 num-tabular">106,04 €</span>
              </div>
              <div>
                <span class="block text-xs text-emerald-300">Llenar en la más barata hoy</span>
                <span id="calc-out-min" class="text-xl font-extrabold text-emerald-300 num-tabular">80,85 €</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <div>
                <span class="block text-xs font-semibold text-amber-200">Ahorro por depósito</span>
                <span id="calc-out-ahorro-dep" class="text-2xl font-black text-amber-300 num-tabular">25,19 €</span>
              </div>
              <div class="text-right">
                <span class="block text-xs font-semibold text-emerald-200">Ahorro estimado al año</span>
                <span id="calc-out-ahorro-anual" class="text-2xl sm:text-3xl font-black text-emerald-300 num-tabular">495 €/año</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       6. SECCIÓN: PREGUNTAS FRECUENTES (FAQ SEO CON DATOS DEL DÍA)
       ============================================================ -->
  <section id="preguntas-frecuentes" class="scroll-mt-16 sm:scroll-mt-20 py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-12">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
          Preguntas Frecuentes sobre el Combustible en Extremadura Hoy
        </h2>
        <p class="text-slate-700 text-base">
          Respuestas directas actualizadas automáticamente con los datos oficiales del día ({fechaLegible}) y la serie histórica 2025–2026.
        </p>
      </div>

      <div class="space-y-4">
        {FAQS_SEO.map((faq, index) => (
          <details
            class="group surface-panel p-5 sm:p-6 transition-colors"
            open={index < 2}
          >
            <summary class="flex items-start justify-between gap-4 font-bold text-slate-900 text-base sm:text-lg cursor-pointer">
              <div>
                <span class="inline-block text-xs font-bold text-sky-800 bg-sky-50 border border-sky-200 px-2 py-0.5 rounded mb-1.5">
                  {faq.categoria}
                </span>
                <span class="block">{faq.pregunta}</span>
              </div>
              <svg
                class="chevron-icon w-5 h-5 text-slate-600 group-hover:text-sky-700 transition-transform shrink-0 mt-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-slate-200 text-slate-700 text-sm sm:text-base leading-relaxed">
              {faq.respuesta}
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- Script Cliente SPA (Buscador de 179 poblaciones, Gráficos Chart.js y Calculadora) -->
  <script src="../scripts/spa.ts"></script>
</BaseLayout>

---
import { SITE_NAME, AUTHOR_NAME, AUTHOR_URL, withBase } from "../lib/site";
import { HOY_EXTREMADURA } from "../data/precios";
---

<footer class="bg-slate-950 text-slate-200 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      
      <!-- Columna 1: Marca y Descripción -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src={withBase("assets/icon-192.png")}
            alt=""
            width="36"
            height="36"
            class="w-9 h-9 rounded-xl"
          />
          <span class="text-lg font-extrabold text-white tracking-tight">
            {SITE_NAME}
          </span>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Monitorización diaria del precio de la Gasolina 95 E5 y el Gasóleo A (Diésel) en las {HOY_EXTREMADURA.extremadura.totalEstaciones} estaciones de servicio de Extremadura. Datos compilados cada mañana a las 06:00h a partir del registro oficial del MITECO.
        </p>
        <p class="text-xs text-slate-300">
          Desarrollado por <a href={AUTHOR_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-300 hover:text-white underline">{AUTHOR_NAME}</a>.
        </p>
      </div>

      <!-- Columna 2: Secciones -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          Secciones
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/#precios-hoy" class="text-slate-300 hover:text-white transition-colors">Precios de Hoy y Localidades</a>
          </li>
          <li>
            <a href="/#comparativa-provincias" class="text-slate-300 hover:text-white transition-colors">Badajoz vs Cáceres Hoy</a>
          </li>
          <li>
            <a href="/#todas-las-poblaciones" class="text-slate-300 hover:text-white transition-colors">Buscador de 179 Municipios</a>
          </li>
          <li>
            <a href="/#historico" class="text-slate-300 hover:text-white transition-colors">Histórico 2025 y 2026</a>
          </li>
          <li>
            <a href="/#guia-ahorro" class="text-slate-300 hover:text-white transition-colors">Guía Práctica de Ahorro</a>
          </li>
          <li>
            <a href="/#preguntas-frecuentes" class="text-slate-300 hover:text-white transition-colors">Preguntas Frecuentes</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Red de Proyectos -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          Red de Proyectos
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="https://luz.antoniohorrillo.com/"
              class="text-slate-300 hover:text-amber-300 transition-colors inline-flex items-center gap-1.5"
              title="Precio de la luz hoy en Extremadura hora a hora (PVPC)"
            >
              <span class="text-amber-400">⚡</span>
              <span>Luz Extremadura</span>
            </a>
            <span class="block text-xs text-slate-300 pl-5">Precio PVPC hora a hora</span>
          </li>
          <li>
            <a
              href="https://embalses.antoniohorrillo.com/"
              class="text-slate-300 hover:text-cyan-300 transition-colors inline-flex items-center gap-1.5"
              title="Nivel de agua y pantanos de Extremadura"
            >
              <span class="text-cyan-400">💧</span>
              <span>Embalses Extremadura</span>
            </a>
            <span class="block text-xs text-slate-300 pl-5">Capacidad y reservas hídricas</span>
          </li>
          <li>
            <a
              href="https://glucoluna.antoniohorrillo.com/"
              class="text-slate-300 hover:text-indigo-300 transition-colors inline-flex items-center gap-1.5"
              title="Calendario y control nocturno de glucosa"
            >
              <span class="text-indigo-400">🌙</span>
              <span>GlucoLuna</span>
            </a>
            <span class="block text-xs text-slate-300 pl-5">Control y diario de glucosa</span>
          </li>
          <li class="pt-1 border-t border-slate-800/80">
            <a
              href="https://antoniohorrillo.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-slate-300 hover:text-white transition-colors underline"
            >
              antoniohorrillo.com · Portafolio
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Fuente Oficial y Privacidad -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          Fuente y Privacidad
        </h3>
        <ul class="space-y-2.5 text-sm text-slate-300">
          <li>
            <span class="block text-white font-semibold">Origen de datos:</span>
            <span class="text-xs">Sede Electrónica MITECO · Orden ITC/2308/2007</span>
          </li>
          <li>
            <span class="block text-white font-semibold">Actualización automática:</span>
            <span class="text-xs">Diaria a las 06:00h (Europe/Madrid)</span>
          </li>
          <li class="pt-1">
            <a href={withBase("cookies/")} class="text-slate-300 hover:text-white transition-colors underline">
              Política de cookies
            </a>
          </li>
          <li>
            <button
              type="button"
              data-open-cookie-preferences
              class="text-sky-300 hover:text-white transition-colors underline cursor-pointer text-left"
            >
              Preferencias de cookies
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Barra inferior -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-300">
      <p>
        © {new Date().getFullYear()} Combustible Extremadura · Creado por <a href={AUTHOR_URL} target="_blank" rel="noopener noreferrer" class="text-sky-300 hover:text-white font-medium underline">{AUTHOR_NAME}</a>
      </p>
      <div class="flex items-center gap-2 text-slate-300 font-semibold">
        <span class="pulse-dot"></span>
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Actualización diaria a las 06:00 h</span>
      </div>
    </div>
  </div>
</footer>
